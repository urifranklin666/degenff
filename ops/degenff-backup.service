[Unit]
Description=degenff nightly Postgres backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=deadplug
Group=deadplug
WorkingDirectory=/home/deadplug/Degeneracy
EnvironmentFile=/etc/degenff/env
ExecStart=/home/deadplug/Degeneracy/ops/backup.sh
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/degenff/backups
PrivateTmp=true
