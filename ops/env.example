# /etc/degenff/env — template. Copy to /etc/degenff/env, chown root:deadplug,
# chmod 0640. The systemd units reference this file via EnvironmentFile=.

# Postgres connection string. Local-socket or TCP both work; the app pools.
DATABASE_URL=postgres://degenff:CHANGE_ME@127.0.0.1:5432/degenff

# Auth.js v5 secret. Generate with: openssl rand -base64 48
AUTH_SECRET=CHANGE_ME

# Canonical site URL. Auth.js uses this for OAuth callbacks.
AUTH_URL=https://your.domain.com

NODE_ENV=production

# Discord application (https://discord.com/developers/applications):
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Guild + channel IDs (right-click in Discord with Developer Mode on → Copy ID):
DISCORD_GUILD_ID=
DISCORD_MOD_QUEUE_CHANNEL_ID=
DISCORD_SHOWCASE_CHANNEL_ID=
DISCORD_FEATS_CHANNEL_ID=
# /board posts locked sentences here (signed by co-conspirators).
# Falls back to DISCORD_SHOWCASE_CHANNEL_ID if blank.
DISCORD_BOARD_CHANNEL_ID=

# Doorman (welcome bot) — leave blank to disable the auto-greeting.
DISCORD_WELCOME_CHANNEL_ID=

# Steno (on-the-record quotes) — leave blank to disable. The emoji defaults
# to 📋 if unset; override with any standard emoji (custom emojis not
# supported by this comparison — would need :name: handling.)
DISCORD_QUOTE_CHANNEL_ID=
DISCORD_QUOTE_EMOJI=📋

# Audit log mirror (every mod action gets a one-line embed posted here).
# Recommended: a mod-only channel. Leave blank to disable.
DISCORD_AUDIT_CHANNEL_ID=

# Scheduled posts. Leave either blank to disable.
#   DIGEST: weekly digest, Saturday 4am UTC (this-week counts)
#   DROP:   random oracle line every 3–6 hours
DISCORD_DIGEST_CHANNEL_ID=
DISCORD_DROP_CHANNEL_ID=

# The Barker (conversational AI layer). Leave ANTHROPIC_API_KEY blank to
# disable it entirely. Replies to @-mentions, replies, keyword hits
# (barker / degenff / degeneratefuckface) in ambient channels, and — in those
# channels — chimes in unprompted on a chatty baseline that ratchets up after
# a human addresses it. Has read-only site lookup tools, can post in channels
# the bot can already see, and (if BARKER_MOD_HOOKS=on) can execute mod
# actions — but ONLY when the caller has a mod/admin role in our users table.
#   ANTHROPIC_API_KEY:    get one at https://console.anthropic.com
#   AMBIENT_CHANNEL_IDS:  comma-separated channel IDs to lurk in (blank = none)
#   BARKER_MODEL:         optional model override (default claude-haiku-4-5)
#   BARKER_MEMORY_MODEL:  optional override for the rolling-gist summarizer
#   BARKER_MOD_HOOKS:     set to "on" to allow mod tools (approve/reject/etc).
#                         Even with on, only callers with role=mod|admin can
#                         actually trigger anything; rate-limited 5/10min/user.
ANTHROPIC_API_KEY=
DISCORD_BARKER_AMBIENT_CHANNEL_IDS=
DISCORD_BARKER_MODEL=
DISCORD_BARKER_MEMORY_MODEL=
BARKER_MOD_HOOKS=

# The Barker in VOICE (full-duplex: hears the room via whisper.cpp, talks back
# via Piper). All self-hosted on the box, zero cloud bills. Run /voice join
# from inside a voice channel; he listens and chimes in with the same instincts
# he has in text. Mutually exclusive with the music player per guild. The whole
# layer stays dark unless ANTHROPIC_API_KEY *and* both binaries below resolve.
# Install the host deps with ops/voice-setup.sh.
#   PIPER_BIN/PIPER_VOICE:   piper TTS binary + path to a .onnx voice model
#   WHISPER_BIN/WHISPER_MODEL: whisper.cpp binary + path to a ggml model
#   WHISPER_THREADS:         optional -t override (default: whisper's own)
#   FFMPEG_BIN:              ffmpeg (already needed by the music player)
PIPER_BIN=piper
PIPER_VOICE=
WHISPER_BIN=whisper-cli
WHISPER_MODEL=
WHISPER_THREADS=
FFMPEG_BIN=ffmpeg

# Verification gate (anti-raid). Bot needs "Manage Roles" permission and
# its highest role must sit ABOVE @verified in the role hierarchy. Channel
# permissions are configured Discord-side: @everyone sees only #verify;
# @verified unlocks the rest of the server. Run /setup-verify once after
# setting these to post the gate.
DISCORD_VERIFY_CHANNEL_ID=
DISCORD_VERIFIED_ROLE_ID=

# Roles that map to site roles. Anyone with DISCORD_ADMIN_ROLE_ID gets
# users.role='admin'; DISCORD_MOD_ROLE_ID gets 'mod'. Everyone else is
# 'contributor'.
DISCORD_MOD_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=

# Optional fallback if you don't enable the public widget on the Discord
# server. Use a permanent (no-expiry, no-max-uses) invite URL.
DISCORD_INVITE_URL=
